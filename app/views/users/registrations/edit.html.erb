<section>
  <div class=" items-center px-5 py-12 lg:px-20">
    <div class="flex flex-col w-full max-w-md p-10 mx-auto my-6 transition duration-500 ease-in-out transform bg-base-200 rounded-lg md:mt-0">
      <div class="mt-3 text-left">
        <div class="inline-flex items-center w-full">
          <h3 class="text-lg font-bold font-lato l eading-6 lg:text-5xl">Edit Account</h3>
        </div>
      </div>
      <div class="flex flex-col">
      <div class="avatar justify-center mt-8">
        <div class="w-20 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2">
          <%= image_tag @user.avatar.url %>
        </div>
      </div>
      <div class="mt-4">
        <div class="mt-4 space-y-2">
          <%= form_with model: resource, url: registration_path(resource_name), local: true do |f| %>
            <% unless devise_error_messages.empty? %>
              <div class="alert alert-warning bg-base-200 text-red-500">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <div class="flex flex-col items-start">
                <%= devise_error_messages %>
                </div>
              </div>
            <% end %>
            <div class="field">
              <%= f.label :name, class: "block text-sm pb-2" %>
              <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "Your Name", class: "block w-full px-5 py-3 text-base placeholder-gray-300 transition duration-500 ease-in-out transform border border-transparent rounded-lg bg-gray-50 focus:outline-none focus:border-transparent focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-300" %>
            </div>
            <div class="flex flex-col">
              <%= f.label :avatar, class: "block text-sm pb-2 pt-6" %>
              <%= f.file_field :avatar, class: "file-input file-input-bordered file-input w-full font-normal" %>
              <%= f.hidden_field :avatar_cache %>
              <span class="text-xs text-right mt-1">（ファイル形式：jpeg、jpg、png、heic）</span>
            </div>
            <div class="mt-6">
              <%= f.submit class: "flex items-center justify-center w-full px-10 py-4 font-medium text-center btn btn-success" %>
            </div>
            <div class="flex items-center justify-between mt-6">
              <div class="text-sm">
                  <%= link_to "マイページに戻る", mypage_path, class: "hover:text-neutral-400" %>
              </div>
              <div class="text-sm">
                  <%= link_to "退会", registration_path(resource_name), data: { turbo_method: :delete, turbo_confirm: '退会しますか?' }, class: "hover:text-neutral-400" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      </div>
    </div>
  </div>
</section>

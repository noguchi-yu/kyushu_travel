<div class="items-center px-5 pt-12 lg:px-20">
  <div class="flex justify-center items-center gap-4 pb-2">
    <div class="avatar">
      <div class="w-16 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2">
        <%= image_tag @user.avatar.url %>
      </div>
    </div>
    <p class="text-xl font-bold px-4"><%= @user.name %></p>
    <%= link_to(edit_user_registration_path, class: "tooltip", "data-tip" => "ユーザー情報編集") do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
      </svg>
    <% end %>
  </div>
  <section>
    <h1 class="flex justify-center pt-12 text-lg font-bold">自分の投稿</h1>
    <div class="mx-auto my-5">
      <% if @users_posts.present? %>
      <div class="flex flex-col items-center p-5">
        <% @users_posts.each do |post| %>
            <%= render 'posts/post', post: post %>
        <% end %>
      </div>
      <div class="flex justify-center">
        <%= paginate @users_posts %>
      </div>
      <% else %>
        <p class="flex justify-center">まだ投稿したスポットがありません。</p>
        <div class="flex justify-center items-center gap-4">
          <p>ぜひあなたのおすすめスポットを投稿しよう！</p>
          <%= link_to new_post_path, data: { turbo: false }, class: "flex items-center text-sm capitalize transition-colors" do %>
              <button class="bg-success text-neutral-800 pl-3 pr-4 py-2 rounded-full w-full flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
                <%= t('header.create_post') %>
              </button>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
</div>

<div class="card w-full lg:w-[820px] bg-neutral-50 shadow-xl mb-5 flex flex-wrap hover:shadow-lg">
  <div class="card-body w-full">
    <div class="flex justify-end">
      <div>
      <%= render 'posts/bookmark_buttons', { post: post } %>
      </div>
    </div>
    <div class="flex flex-wrap justify-center md:justify-start">
      <div class="w-44 md:mr-10">
        <% if post.images.present? %>
          <% first_image = post.images.first %>
          <%= image_tag first_image.to_s, class: "aspect-[3/2] object-cover" %>
        <% else %>
          <%= image_tag 'no_image.png', class: "aspect-[3/2] object-cover" %>
        <% end %>
      </div>
      <div class="flex flex-col w-auto">
        <div class="flex items-center">
          <h4 class="card-title">
            <%= link_to post.title, post_path(post) %>
          </h4>
          <% if current_user.own_post?(post) %>
            <%= link_to(edit_post_path(post), class: "tooltip", "data-tip" => "編集", data: { turbo: false }) do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 ml-5 mr-2 hover:text-primary">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
              </svg>
            <% end %>
            <%= link_to(post_path(post), data: { turbo_method: :delete, turbo_confirm: '削除しますか?' }, class: "tooltip", "data-tip" => "削除") do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 mx-3 hover:text-primary">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
              </svg>
            <% end %>
          <% end %>
        </div>
        <p class="m-2 text-xs text-neutral-500">
          <%= extract_address(post.address) %>
        </p>
        <div class="mb-5">
          <% post.tags.each do |tag| %>
            <span class="badge badge-success gap-2"><%= tag.name %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
